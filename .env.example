APP_NAME=ChurchFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes every message to storage/logs/laravel.log and delivers nothing.
# That is the right default for tests, and the WRONG setting anywhere a real
# person is waiting for a password-reset email. To actually send, set
# MAIL_MAILER=smtp and fill in the four values below - all five are needed;
# config/mail.php refuses an smtp mailer with no host rather than silently
# dialling localhost.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-church-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# --- Billing (Phase 8) ---
# Unset => the webhook endpoint rejects every request. Fails CLOSED on purpose:
# an unverified webhook is the one request that can mark an invoice paid and
# activate a church, so "no secret configured" must never mean "accept anything".
PAYMENT_WEBHOOK_SECRET=
# Unset => selling SMS credits is refused outright rather than charging an
# invented default price (see BillingController::buySmsCredits).
SMS_PRICE_PER_UNIT=
# Which gateway the app uses: null | paystack. Defaults to `null`, so the app
# runs and the suite passes without any credentials. Set PAYMENT_GATEWAY=paystack
# AND a secret key to take real payments — both are required; a key alone is not
# enough, and a gateway without a key throws rather than faking success.
PAYMENT_GATEWAY=null
# Sandbox keys start with sk_test_. Never commit a live key (sk_live_).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- SMS provider (Phase 7) ---
# Unset => the network-free NullSmsProvider is used (dev + tests).
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Platform health (Phase 13) ---
# The /health page reports every check regardless of these; they only decide
# which failures make the platform REPORT as degraded (503 from /health.json).
# Both default to true, so no configuration is needed to keep the strict
# behaviour. local/testing never report degraded either way (see config/health.php).
#
# Set to false to let a deployment run without these dependencies configured
# without the status page going red — e.g. an install that has not started
# selling yet, where a missing webhook secret is expected rather than a fault.
HEALTH_QUEUE_WORKER_SEVERITY=true
HEALTH_PAYMENTS_SEVERITY=true
#
# Force a check's severity ON even in local/testing, or OFF even in production.
# Null (unset) means "no override" — defer to the environment rules above.
# HEALTH_FORCE_QUEUE_WORKER_SEVERITY=
# HEALTH_FORCE_PAYMENTS_SEVERITY=