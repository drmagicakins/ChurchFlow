APP_NAME=ChurchFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes every message to storage/logs/laravel.log and delivers nothing.
# That is the right default for tests, and the WRONG setting anywhere a real
# person is waiting for a password-reset email. To actually send, set
# MAIL_MAILER=smtp and fill in the values below - all of them are needed;
# config/mail.php refuses an smtp mailer with no host rather than silently
# dialling localhost.
#
# !!! NEVER PUT A REAL CREDENTIAL IN THIS FILE. !!!
# .env.example is COMMITTED and pushed to the repository. Anything typed here
# is public for ever, including in past git history after it is removed.
# Real values belong in .env (gitignored) or the host's environment panel.
#
# --- Gmail SMTP (example shape only) ---
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp       (Laravel 12: `smtp` = STARTTLS on 587, `smtps` =
#                           implicit TLS on 465. NOT `tls` — that is the DSN
#                           scheme and Laravel rejects it. Blank also works:
#                           it picks `smtp` for 587 and `smtps` for 465.)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=         <- a 16-character Google APP PASSWORD, never the
#                             account password. Google requires 2-Step
#                             Verification before App Passwords exist.
#   MAIL_FROM_ADDRESS=you@gmail.com   <- must match the SMTP account, or Gmail
#                                       rewrites it and mail looks forged.
#   MAIL_FROM_NAME="ChurchFlow"
#
# --- What THIS project runs on (2026-11-17) ---
# The development and deployment .env both use Gmail over 465 / `smtps`:
# port 587 was blocked by the network here (connection timed out, error 10060)
# while 465 connected, authenticated and delivered. MAIL_MAILER stays `log` in
# THIS FILE on purpose, so a test run or a fresh clone never dials out; copy the
# shape below into your own .env (gitignored) to send real mail:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=         <- the 16-character Google APP PASSWORD
#   MAIL_FROM_ADDRESS=you@gmail.com
#   MAIL_FROM_NAME="ChurchFlow"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-church-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- A note on APP_URL and DB_DATABASE (2026-11-17) ---
# The live .env sets APP_URL to the deployment domain and an ABSOLUTE filesystem
# path for DB_DATABASE. Both stay out of this file on purpose: phpunit.xml forces
# APP_URL=http://localhost:8000 for the suite, and CI copies this file for a Linux
# runner, where a Windows path cannot exist. Keep the relative
# DB_DATABASE=database/database.sqlite here, and set the absolute path only in
# the .env of the machine that needs it.
#
# APP_KEY is likewise never written here. A clone generates its own with
# `php artisan key:generate`. The .env's key decrypts sessions and the 2FA
# secret column, so it belongs to the installation, not to the repository.
# APP_DEBUG=true is the local setting; keep it OFF anywhere a real visitor can
# reach (see SESSION-HANDOFF.md S5).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# --- Billing (Phase 8) ---
# Unset => the webhook endpoint rejects every request. Fails CLOSED on purpose:
# an unverified webhook is the one request that can mark an invoice paid and
# activate a church, so "no secret configured" must never mean "accept anything".
PAYMENT_WEBHOOK_SECRET=
# Unset => selling SMS credits is refused outright rather than charging an
# invented default price (see BillingController::buySmsCredits).
SMS_PRICE_PER_UNIT=
# Which gateway the app uses: null | paystack. Defaults to `null`, so the app
# runs and the suite passes without any credentials. Set PAYMENT_GATEWAY=paystack
# AND a secret key to take real payments — both are required; a key alone is not
# enough, and a gateway without a key throws rather than faking success.
# THE PROJECT'S ACTUAL SETTING IS `paystack` (sandbox). It is not written here
# because CI copies this file and the suite needs the network-free gateway; put
# `PAYMENT_GATEWAY=paystack` in your local .env together with the two keys below.
# phpunit.xml forces `null` regardless, so a local .env is safe to set either way.
PAYMENT_GATEWAY=null
# Sandbox keys start with sk_test_. Never commit a live key (sk_live_).
# Where the keys live: in .env (gitignored) - never in this file, whose whole
# content is public for ever. This project uses SANDBOX (test) keys for the same
# Paystack account as the deployment; a live key must never appear in any commit.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack sends the browser after payment. Unset => each checkout's own
# signed-in verify route (route('checkout.verify')), which works on any host.
# The return is only a hint: the app always re-verifies server-to-server.
#
# The Paystack dashboard's "Callback URL" field is separate and must be a
# LITERAL url - it rejects placeholders like {checkout}. It is only a fallback
# because the app sends a per-checkout callback_url on every initialise call,
# so set it to any real page, e.g. https://your-domain/checkout/1/failed
PAYSTACK_CALLBACK_URL=
# Optional override for the key Paystack signs webhooks with. Blank =>
# PAYSTACK_SECRET_KEY, which is what Paystack itself uses. The endpoint
# (POST /api/v1/webhooks/paystack) fails CLOSED when neither is set.
#
# The WEBHOOK URL to paste into the Paystack dashboard is NOT an environment
# value: this deployment uses https://churchflow.com.ng/api/v1/webhooks/paystack
# (Paystack needs a publicly reachable HTTPS url; localhost never receives one).
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=

# The church logo is uploaded to THIS install's public disk (public/storage),
# and emails embed it by absolute URL. Blank => APP_URL + /storage, which is
# correct when the machine that sends email is the one that received the logo.
# If another host holds the logos (e.g. uploads made against a local install),
# set it on the SENDING machine, e.g. http://127.0.0.1:8000
CHURCH_LOGO_URL=

# --- Email verification (2026-11-17) ---
# Minutes a signed confirmation link stays valid. 24 hours rather than Laravel's
# 60-minute default, for the same reason the password-reset window is longer: a
# link is opened from an inbox, often much later. config/auth.php reads this and
# both the mail and the notice page quote the same number.
AUTH_VERIFICATION_EXPIRE=1440

# --- SMS provider (Phase 7) — Termii ---
# Unset => the network-free NullSmsProvider is used (dev + tests). The real
# provider is selected only when SMS_GATEWAY=termii AND a key exists; a named
# gateway with no key throws at first use rather than reporting "sent".
#
# !!! THE API KEY BELOW MUST STAY BLANK !!! It was pasted here by mistake
# (2026-11-17) and removed: this file is COMMITTED and public. Put the real key
# in your local .env (gitignored) or the host's environment panel.
SMS_GATEWAY=null
TERMII_API_KEY=
# PLATFORM FALLBACK sender id — NOT the sender the church sees.
#
# Per the church's requirement (2026-11-17) a text goes out under the NAME OF THE
# CHURCH sending it, or the PARISH's name when the message belongs to a parish
# (resolved per send by SmsSenderName, e.g. "Lekki · Grace"). This value is only
# the fallback for a church with no usable name, and it must be one of the
# APPROVED sender ids on the Termii account — an unapproved `from` is refused by
# Termii. Leave it empty and a church that has a name still sends fine.
#
# ON THIS DEPLOYMENT (2026-11-25) the value is ChurchFlow, and it IS approved and
# active on the account (verified with GET /api/sender-id). config/services.php
# also names it as the default, so a deploy whose .env predates the value still
# sends under it. It is ACCOUNT-WIDE, which is what makes SMS work for EVERY
# church, owner and parish pastor without registering a header per church.
TERMII_SENDER_ID=
# WHOSE NAME the text is sent under.
#
# false (default): every message uses TERMII_SENDER_ID — the account's one
#   APPROVED header. "ChurchFlow" is APPROVED and active (2026-11-25), so this
#   is the mode this deployment runs in, for every church.
# true:    a message uses the CHURCH's name (or "Parish · Church" when it belongs
#   to a parish). Only switch this on when each church holds an APPROVED sender id
#   of its own — Termii refuses any `from` that is not approved, so an
#   unregistered church name fails EVERY send.
SMS_SENDER_FROM_CHURCH_NAME=false
# Base URL. Termii routes accounts to different hosts (v3/v4); this deployment
# answers on v4 for sender-id and balance, so that is the default.
TERMII_BASE_URL=https://v4.api.termii.com
# dnd (routes around Nigerian DND blocks, needs an approved sender id) or
# generic. dnd matches Termii's own examples.
TERMII_CHANNEL=dnd
# Optional CA bundle for TLS verification — see PAYSTACK_CA_BUNDLE for why.
# TERMII_CA_BUNDLE=

# --- Platform health (Phase 13) ---
# The /health page reports every check regardless of these; they only decide
# which failures make the platform REPORT as degraded (503 from /health.json).
# Both default to true, so no configuration is needed to keep the strict
# behaviour. local/testing never report degraded either way (see config/health.php).
#
# Set to false to let a deployment run without these dependencies configured
# without the status page going red — e.g. an install that has not started
# selling yet, where a missing webhook secret is expected rather than a fault.
HEALTH_QUEUE_WORKER_SEVERITY=true
HEALTH_PAYMENTS_SEVERITY=true
#
# Force a check's severity ON even in local/testing, or OFF even in production.
# Null (unset) means "no override" — defer to the environment rules above.
# HEALTH_FORCE_QUEUE_WORKER_SEVERITY=
# HEALTH_FORCE_PAYMENTS_SEVERITY=
